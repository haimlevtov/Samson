# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — local stack values are printed by `supabase start`.
# On the hosted project these are the project URL and the publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter. Read only by src/llm/ — see CLAUDE.md #2.
OPENROUTER_API_KEY=
# Optional: sent as HTTP-Referer/X-Title so calls are attributable on the
# OpenRouter dashboard. Cosmetic; the gateway works without them.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Samson

# Optional: comma-separated override of the model fallback array.
# Leave unset to use the defaults in src/llm/models.ts.
LLM_MODELS=

# Test and script use only — never read by application code (CLAUDE.md #10).
# Local values come from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
