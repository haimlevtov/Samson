{
  "name": "samson",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "migrate": "supabase db reset",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "catalogue:fetch": "tsx scripts/fetch-catalogue.ts",
    "inspect:seed": "tsx scripts/inspect-archetypes.ts",
    "db:push": "supabase db push",
    "db:types:inspect": "supabase gen types typescript --linked",
    "eval:planner": "tsx scripts/eval-planner.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run eval:planner && npm run eval:planner -- --naive",
    "demo:llm": "tsx scripts/eval-planner.ts --live --limit 1 --max-spend 0.15",
    "challenges:generate": "tsx scripts/generate-challenges.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.9.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
